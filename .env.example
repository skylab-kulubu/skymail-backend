DATABASE_URL=postgres://skymail:postgres@localhost:5432/skymail?sslmode=disable
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FQDN=
SMTP_PLAIN=FALSE
KEYCLOAK_REALM_URL=https://e.yildizskylab.com/realms/e-skylab
KEYCLOAK_CLIENT_ID=skymail
KEYCLOAK_SERVICE_CLIENT_ID=skymail-backend
KEYCLOAK_SERVICE_CLIENT_SECRET=
APP_PORT=3000

# Shared account-access gate. Keep `off` until the dedicated persistent Redis,
# read-only ACL and mTLS files are provisioned. `enforce` accepts no defaults.
ACCOUNT_ACCESS_GATE_MODE=off
ACCOUNT_ACCESS_REDIS_ADDR=
ACCOUNT_ACCESS_REDIS_USERNAME=
ACCOUNT_ACCESS_REDIS_PASSWORD=
ACCOUNT_ACCESS_REDIS_DB=
ACCOUNT_ACCESS_REDIS_TLS=
ACCOUNT_ACCESS_REDIS_TLS_SERVER_NAME=
ACCOUNT_ACCESS_REDIS_TLS_CERT_FILE=
ACCOUNT_ACCESS_REDIS_TLS_KEY_FILE=
ACCOUNT_ACCESS_REDIS_CA_CERT_FILE=
ACCOUNT_ACCESS_REDIS_OPERATION_TIMEOUT=200ms
